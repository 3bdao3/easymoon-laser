# Example only — do not put real secrets in git.
# For Render, set these in the dashboard (not in a committed file).

# Backend
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=YOUR_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;
FRONTEND_URL=https://YOUR-FRONTEND.onrender.com
Authentication__Jwt__SigningKey=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Authentication__InitialReceptionist__UserName=socialmedia
Authentication__InitialReceptionist__Email=socialmedia@easymoon.local
Authentication__InitialReceptionist__Password=REPLACE_WITH_STRONG_PASSWORD
Authentication__InitialReceptionist__FullName=موظفة السوشيال ميديا

# Frontend (Static Site build-time)
API_BASE_URL=https://YOUR-BACKEND.onrender.com
